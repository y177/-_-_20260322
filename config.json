{
  "_설명": "이야기 동화관 앱 설정 파일입니다. 이 파일을 수정하여 앱 동작을 변경할 수 있습니다.",

  "app": {
    "name": "이야기 동화관",
    "subtitle": "아이들의 이야기를 소중히 담습니다",
    "version": "1.0.0"
  },

  "story": {
    "_설명": "이야기 생성 관련 설정",
    "minScenes": 4,
    "maxScenes": 6,
    "sampleStories": [
      "토끼가 달나라에서 떡을 만들어요",
      "용감한 공룡이 폭풍우를 헤치고 친구를 구해요",
      "작은 별이 하늘에서 내려와 아이와 친구가 됐어요"
    ]
  },

  "image": {
    "_설명": "이미지 생성 관련 설정",
    "style": "children's book illustration, watercolor style, warm colors, safe for kids",
    "timeoutMs": 8000
  },

  "api": {
    "_설명": "API 관련 설정",
    "storageKey": "gemini_api_key",
    "storyModel": "gemini-2.0-flash",
    "imageModel": "gemini-2.0-flash-preview-image-generation"
  },

  "logging": {
    "_설명": "로그 관련 설정",
    "enabled": true,
    "storageKey": "app_logs",
    "maxEntries": 100
  },

  "deploy": {
    "_설명": "배포 관련 정보 (참고용)",
    "platform": "Netlify",
    "nodeVersion": "20",
    "buildCommand": "npm run build",
    "publishDir": "dist",
    "functionsDir": "netlify/functions"
  }
}
